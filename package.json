{
  "name": "cloud-iam-keycloak-theme",
  "version": "26.6.2",
  "keywords": [
    "keycloak",
    "theme",
    "keycloak-theme"
  ],
  "description": "Cloud-IAM Theme for Keycloak",
  "scripts": {
    "clean": "rm -rf ./src/main/resources/theme/cloud-iam-redesign/login/resources/dist .parcel-cache",
    "build": "npm run clean && parcel build --dist-dir=./src/main/resources/theme/cloud-iam-redesign/login/resources/dist/ src/main/resources/theme/cloud-iam-redesign/login/resources/scss/*.scss"
  },
  "author": "Francois-Guillaume Ribreau <npm@fgribreau.com> (http://fgribreau.com/)",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-image": "^2.12.0",
    "@parcel/transformer-sass": "^2.12.0",
    "@tailwindcss/forms": "^0.5.7",
    "parcel": "^2.12.0"
  },
  "dependencies": {
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
